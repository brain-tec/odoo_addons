<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ecotaxe_purchaseorder_inherit"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_price_unit']" position="after">
            <th name="th_ecotaxe_unit" class="text-end">
                <strong>Unit Ecotaxe</strong>
            </th>
        </xpath>
        <xpath expr="//span[@t-field='line.price_unit']/.." position="after">
            <td class="text-end">
                <span t-field="line.ecotaxe_unit"/>
            </td>
        </xpath>
    </template>
</odoo>
